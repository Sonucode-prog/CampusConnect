# ================================

# COMPUSCONNECT - .gitignore

# ================================

# ---------- Environment Variables ----------

.env
.env.*
!.env.example

# ---------- Python ----------

**pycache**/
*.py[cod]
*$py.class

# Virtual Environment

venv/
env/
.venv/
ENV/

# Python packaging

*.egg
*.egg-info/
dist/
build/
.eggs/

# ---------- FastAPI / Uvicorn ----------

*.log
logs/

# ---------- Celery ----------

celerybeat-schedule
celerybeat.pid

# ---------- Database ----------

*.db
*.sqlite
*.sqlite3

# ---------- Node.js ----------

**/node_modules/

# ---------- Frontend Build ----------

dist/
build/
.vite/

# ---------- npm ----------

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Vue ----------

.DS_Store
*.local

# ---------- IDE / Editors ----------

.vscode/
.idea/
*.swp
*.swo

# ---------- Operating System ----------

.DS_Store
Thumbs.db
Desktop.ini

# ---------- Temporary Files ----------

*.tmp
*.temp
*.bak
*.swp

# ---------- Test / Coverage ----------

.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# ---------- Jupyter ----------

.ipynb_checkpoints/

# ---------- Type Checking ----------

.mypy_cache/
.pyright/

# ---------- Documentation / Generated Files ----------

*.generated.*

# ---------- Uploads / User Generated Files ----------

uploads/
media/

# ---------- Secrets / Certificates ----------

*.pem
*.key
*.crt
*.p12

# ---------- Local Configuration ----------

config.local.*
settings.local.*

# ---------- OS / Editor Metadata ----------

*.orig
*.rej
*.DS_Store
